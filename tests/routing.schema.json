{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "skill": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*|none)$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  },
  "required": ["skill", "reason"]
}
